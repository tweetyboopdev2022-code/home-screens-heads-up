{
  "id": "heads-up",
  "name": "Heads-up",
  "version": "1.0.0",
  "description": "Only what needs attention right now: bins going out, overdue chores per person, Souper Cubes running low, tomorrow's dinner not planned. Says All clear otherwise.",
  "author": "Tanya",
  "license": "MIT",
  "minAppVersion": "1.7.1",
  "moduleType": "heads-up",
  "category": "Personal",
  "icon": "Bell",
  "defaultConfig": {
    "title": "Heads-up",
    "pickups": "Trash: Wed every 2 weeks from 2026-09-16, Recycling: Wed every 2 weeks from 2026-09-23, Compost: Thu weekly",
    "people": "Vince, Tanya, Nora",
    "colors": "Vince:#34d399, Tanya:#fbbf24, Nora:#f472b6",
    "skipProjects": "Groceries, Souper Cubes",
    "souperProject": "Souper Cubes",
    "lowAt": 1,
    "mealNudge": true,
    "maxItems": 3
  },
  "defaultSize": {
    "w": 360,
    "h": 240
  },
  "defaultStyle": {
    "fontSize": 18,
    "padding": 20,
    "borderRadius": 28
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title",
        "ui:widget": "text",
        "ui:group": "Content"
      },
      "pickups": {
        "type": "string",
        "title": "Bin pickups",
        "ui:widget": "text",
        "ui:group": "Content",
        "description": "e.g. Trash: Wed every 2 weeks from 2026-09-16, Compost: Thu weekly"
      },
      "people": {
        "type": "string",
        "title": "People (Todoist labels)",
        "ui:widget": "text",
        "ui:group": "Content",
        "description": "Tapping someone's row opens their screen."
      },
      "skipProjects": {
        "type": "string",
        "title": "Ignore these Todoist projects",
        "ui:widget": "text",
        "ui:group": "Content"
      },
      "souperProject": {
        "type": "string",
        "title": "Souper Cubes project",
        "ui:widget": "text",
        "ui:group": "Content"
      },
      "lowAt": {
        "type": "number",
        "title": "Souper Cubes low at",
        "minimum": 1,
        "maximum": 5,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Content"
      },
      "mealNudge": {
        "type": "boolean",
        "title": "Nudge when tomorrow's dinner isn't planned",
        "ui:widget": "toggle",
        "ui:group": "Content"
      },
      "maxItems": {
        "type": "number",
        "title": "Max rows",
        "minimum": 1,
        "maximum": 6,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Look"
      },
      "colors": {
        "type": "string",
        "title": "Person colours",
        "ui:widget": "text",
        "ui:group": "Look"
      }
    }
  },
  "exports": {
    "component": "default"
  },
  "dataRequirements": [],
  "prefetchUrl": null,
  "permissions": [
    "events"
  ]
}